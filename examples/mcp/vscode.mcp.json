{
  "inputs": [
    {
      "id": "deepseek-api-key",
      "type": "promptString",
      "description": "DeepSeek API Key",
      "password": true
    }
  ],
  "servers": {
    "deepseek_web_search": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "github:Ming-QWQ520/deepseek-web-search#v0.1.0"
      ],
      "env": {
        "DEEPSEEK_API_KEY": "${input:deepseek-api-key}"
      }
    }
  }
}
